# Default provider (KSM): the two values below are used as-is.
KSM_CONFIG_BASE64:
KSM_RECORD_UID:

# Optional. Where SCIM parameters come from:
#   KSM (default): read from a Keeper Secrets Manager record (uses the two vars above).
#   GCP: build parameters from per-field Google Secret Manager secrets (the vars below).
#        Each value is a secret reference: a short name (project auto-detected on
#        Cloud Run, version "latest") or a full
#        projects/<PROJECT>/secrets/<SECRET>/versions/<VERSION> path.
# SECRET_PROVIDER: GCP
# SCIM_URL: scim-url
# SCIM_TOKEN: scim-token
# GCP_ADMIN_ACCOUNT: scim-admin-account
# GCP_CREDENTIALS: scim-credentials
# SCIM_GROUPS: scim-groups
# SCIM_VERBOSE: "false"
# SCIM_DESTRUCTIVE: "0"
